# --- Server ---
AMEM_HOST=127.0.0.1
AMEM_PORT=8321
AMEM_DB_PATH=./data/amem.db
# Bearer token required on /api routes when set (recommended for non-localhost)
AMEM_API_TOKEN=
AMEM_CORS_ORIGIN=

# --- Embeddings (offline deterministic by default; no network) ---
AMEM_EMBEDDING_MODE=offline            # offline | api
AMEM_EMBEDDING_BASE_URL=               # e.g. https://api.openai.com/v1
AMEM_EMBEDDING_MODEL=                  # e.g. text-embedding-3-small
AMEM_EMBEDDING_API_KEY=
AMEM_EMBEDDING_DIMS=64

# --- LLM (distillation / context assembly) ---
AMEM_LLM_BASE_URL=                     # e.g. https://api.openai.com/v1
AMEM_LLM_MODEL=                        # e.g. gpt-4o-mini
AMEM_LLM_API_KEY=

# --- Thresholds (optional) ---
AMEM_MIN_SOURCES_FOR_CRYSTAL=3
AMEM_MIN_SHARED_TAGS=3
AMEM_DEDUP_SIM_THRESHOLD=0.9
AMEM_LINK_SIM_THRESHOLD=0.72
AMEM_CONTRADICTION_THRESHOLD=0.6
AMEM_DECAY_PER_DAY=0.02
AMEM_FORGET_THRESHOLD=0.3
AMEM_WORKING_MEMORY_BUDGET=3000
AMEM_RECALL_BUDGET=4000

# --- Background jobs ---
AMEM_JOBS_ENABLED=true
# Auto-precipitate assets after every ingest (off | fast | auto | full).
# fast = heuristic-only (no LLM cost). Default off in code; docker compose sets fast.
AMEM_AUTO_PRECIPITATE=fast
AMEM_JOBS_DEBOUNCE_MS=5000
AMEM_JOBS_INTERVAL_MS=30000
AMEM_JOBS_MAX_PER_HOUR=60
AMEM_JOBS_TOKEN_BUDGET_DAILY=200000

# --- Auth / workspaces ---
AMEM_AUTH_ENABLED=false
AMEM_TRUST_PROXY=false                    # true only behind a reverse proxy (rate-limit client IPs)
AMEM_COOKIE_SECURE=false                  # true for HTTPS deployments (adds Secure to session cookie)
AMEM_AUTH_SECRET=
AMEM_ALLOW_LEGACY_API_TOKEN=              # unset = on only when auth disabled; set false to force off after migration
AMEM_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
AMEM_BOOTSTRAP_ADMIN_PASSWORD=admin
AMEM_PAT_DEFAULT_TTL_DAYS=90
AMEM_RATE_LIMIT_ENABLED=true              # per-IP throttle for login/token endpoints
AMEM_RATE_LIMIT_LOGIN_PER_MINUTE=10
AMEM_RATE_LIMIT_BOOTSTRAP_PER_HOUR=3
AMEM_RATE_LIMIT_OAUTH_PER_MINUTE=20       # /oauth/authorize + /oauth/token + /oauth/consent + /oauth/revoke
AMEM_RATE_LIMIT_REGISTER_PER_HOUR=10
# MCP over HTTP: 1 = require OAuth/PAT (recommended), 0 = open local demo
AMEM_MCP_OAUTH=1
