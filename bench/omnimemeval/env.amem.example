# OmniMemEval / Amem environment — copy to .env.amem and adjust.

# Amem bench instance (dedicated, separate from your daily store!)
AMEM_BASE_URL=http://127.0.0.1:8322
AMEM_API_TOKEN=amem_pat_...
AMEM_TIMEOUT=1500

# Harness answer + judge models (OpenAI-compatible endpoint).
# The example points at a local proxy; swap in any provider.
ANSWER_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
ANSWER_BASE_URL=http://127.0.0.1:15721/v1
ANSWER_API_KEY=local

EVAL_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
EVAL_BASE_URL=http://127.0.0.1:15721/v1
EVAL_API_KEY=local

# Pipeline tuning (same as the reference runs where possible)
OMNIMEMEVAL_MEMORY_MAX_RETRIES=8
LLM_MAX_RETRIES=4
TOPK=20
NUM_RUNS=1
