{
  "name": "amem",
  "version": "0.2.0",
  "private": true,
  "description": "Amem \u2014 self-hosted, local-first agent knowledge & memory layer",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --parallel -r --if-present run dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present run test",
    "test:cov": "pnpm -r --if-present run test:cov",
    "smoke": "node tools/smoke.mjs",
    "pat:codex": "node tools/amem-auto-pat.mjs",
    "setup": "node tools/amem-setup.mjs all",
    "setup:verify": "node tools/amem-setup.mjs verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
