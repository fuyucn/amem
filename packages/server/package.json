{
  "name": "@amem/server",
  "version": "0.2.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.js.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@amem/core": "workspace:*",
    "@amem/db": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.0",
    "@amem/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "bin": {
    "amem-server": "dist/cli.js"
  }
}
